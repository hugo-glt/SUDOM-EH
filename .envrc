# Vérifie que les outils requis sont installés
if ! command -v cargo &> /dev/null; then
  echo "⚠️  Rust/cargo introuvable. Installe-le via https://rustup.rs"
fi

if ! command -v node &> /dev/null; then
  echo "⚠️  Node introuvable. Installe-le via nvm : https://github.com/nvm-sh/nvm"
fi

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
nvm use

export RUST_LOG=debug
export BACK_PORT=3000
export FRONT_PORT=5173
export VITE_API_BASE_URL="http://localhost:3000"